name: Deploy Backend to Cloud Run

on:
  push:
    branches:
      - main  # 當推送到 main 分支時觸發
    paths:
      - '**'  # 監聽所有檔案變更

env:
  # --- 基本設定 (根據您的 Artifact Registry 截圖) ---
  REGION: asia-east1
  REPO_NAME: freelancer-repo
  SERVICE_NAME: freelancer-backend
  # 完整的 Artifact Registry Image 路徑
  IMAGE_URL: asia-east1-docker.pkg.dev/${{ secrets.GCP_PROJECT_ID }}/freelancer-repo/freelancer-backend

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      # 1. 認證 GCP (使用 Secrets 中的 JSON Key)
      - name: Authenticate to Google Cloud
        uses: google-github-actions/auth@v2
        with:
          credentials_json: ${{ secrets.GCP_CREDENTIALS }}

      # 2. 設定 gcloud 環境
      - name: Set up Cloud SDK
        uses: google-github-actions/setup-gcloud@v2

      # 3. 設定 Docker Auth (讓 Docker 能推送到 Artifact Registry)
      - name: Configure Docker for Artifact Registry
        run: |
          gcloud auth configure-docker ${{ env.REGION }}-docker.pkg.dev

      # 4. 打包並上傳 Docker Image
      - name: Build and Push Container
        run: |
          docker build -t ${{ env.IMAGE_URL }}:latest .
          docker push ${{ env.IMAGE_URL }}:latest

      # 5. 部署到 Cloud Run
      - name: Deploy to Cloud Run
        run: |
          gcloud run deploy ${{ env.SERVICE_NAME }} \
            --image ${{ env.IMAGE_URL }}:latest \
            --region ${{ env.REGION }} \
            --platform managed \
            --allow-unauthenticated \
            --port 8000 \
            --service-account freelancer-match@${{ secrets.GCP_PROJECT_ID }}.iam.gserviceaccount.com \
            --set-env-vars "PORT=8000" \
            --set-env-vars "FILE_STORAGE_MODE=gcs" \
            --set-env-vars "DATABASE_URL=${{ secrets.DATABASE_URL }}" \
            --set-env-vars "REDIS_URL=${{ secrets.REDIS_URL }}" \
            --set-env-vars "JWT_SECRET_KEY=${{ secrets.JWT_SECRET_KEY }}" \
            --set-env-vars "GCS_BUCKET_NAME=${{ secrets.GCS_BUCKET_NAME }}" \
            --set-env-vars "BACKEND_CORS_ORIGINS=${{ secrets.BACKEND_CORS_ORIGINS }}"